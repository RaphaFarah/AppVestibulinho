# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://SEUPROJETO.supabase.co

# Somente em projetos que ainda assinam em HS256 (Project Settings -> API ->
# JWT Secret). Em projeto novo, deixe vazio: a validacao usa o JWKS publico.
SUPABASE_JWT_SECRET=

# Origens autorizadas, separadas por virgula
CORS_ORIGINS=http://localhost:5173
